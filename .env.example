# Canonical environment template
# Do not commit real secrets.
# Profiles for multi-backend work:
# - env/profiles/local.env.example
# - env/profiles/staging.env.example
# - env/profiles/prod.env.example

# =========================
# Public (required)
# =========================
NEXT_PUBLIC_INSFORGE_BASE_URL=https://your-app.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-insforge-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================
# Privileged (recommended for webhook/admin/debug flows)
# =========================
INSFORGE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INSFORGE_ADMIN_API_KEY=
STRIPE_WEBHOOK_SECRET=
ALERTS_CRON_SECRET=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v21.0
META_WA_TEMPLATE_NAME=property_alert_v1

# =========================
# n8n Integration
# =========================
N8N_SCRAPER_WEBHOOK_URL=https://your-n8n-instance/webhook/scraper
N8N_WEBHOOK_SHARED_SECRET=replace-with-random-secret

# =========================
# Feature flags
# =========================
FEATURE_INSFORGE_AUTH=true
FEATURE_INSFORGE_PROPERTIES=false
FEATURE_INSFORGE_SCRAPER=false
FEATURE_INSFORGE_MARKETING=false
FEATURE_INSFORGE_MANAGER=false
FEATURE_ADMIN_IMPERSONATION=false
FEATURE_SKIP_EMAIL_VERIFICATION=false
FEATURE_COMPARE=false
FEATURE_FAVORITES_SYNC=false
FEATURE_SAVED_SEARCH=false
FEATURE_WHATSAPP_ALERTS=false
FEATURE_ZONE_INSIGHTS=false
FEATURE_THEME_LAB_EDITORIAL=false
FEATURE_GEOCATASTRO_LOOKUP=false
FEATURE_LEGAL_COMMISSION_GUIDE=false
FEATURE_AGENCY_VALUE_SCORE=false
