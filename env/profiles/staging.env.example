# Staging profile (shared QA backend)
# Do not commit secrets; use your secret manager.
# IMPORTANT: no wrapping quotes and no literal \n suffixes in values.

NEXT_PUBLIC_INSFORGE_BASE_URL=https://your-staging.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=<staging-anon-key>
NEXT_PUBLIC_APP_URL=https://staging.example.com

INSFORGE_SERVICE_ROLE_KEY=<staging-service-key>
SUPABASE_SERVICE_ROLE_KEY=
INSFORGE_ADMIN_API_KEY=
STRIPE_WEBHOOK_SECRET=<staging-stripe-webhook-secret>
ALERTS_CRON_SECRET=<staging-alerts-cron-secret>
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v21.0
META_WA_TEMPLATE_NAME=property_alert_v1

FEATURE_INSFORGE_AUTH=true
FEATURE_INSFORGE_PROPERTIES=true
FEATURE_INSFORGE_SCRAPER=true
FEATURE_INSFORGE_MARKETING=true
FEATURE_INSFORGE_MANAGER=true
FEATURE_ADMIN_IMPERSONATION=false
FEATURE_SKIP_EMAIL_VERIFICATION=false
FEATURE_COMPARE=false
FEATURE_FAVORITES_SYNC=false
FEATURE_SAVED_SEARCH=false
FEATURE_WHATSAPP_ALERTS=false
FEATURE_ZONE_INSIGHTS=false
FEATURE_THEME_LAB_EDITORIAL=false
FEATURE_GEOCATASTRO_LOOKUP=false
FEATURE_LEGAL_COMMISSION_GUIDE=false
FEATURE_AGENCY_VALUE_SCORE=false

N8N_SCRAPER_WEBHOOK_URL=
