# Canonical runtime source for Vercel staging/preview sync.
# Rules:
# - Do not wrap values in quotes.
# - Do not include literal \n suffixes.
# - Keep booleans as plain true/false (case-insensitive).
# - Never commit real secrets; replace placeholders from secret manager before sync.

NEXT_PUBLIC_INSFORGE_BASE_URL=https://your-staging.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=replace-with-staging-anon-key
NEXT_PUBLIC_APP_URL=https://staging.example.com

INSFORGE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INSFORGE_ADMIN_API_KEY=replace-with-staging-admin-key
STRIPE_WEBHOOK_SECRET=
ALERTS_CRON_SECRET=replace-with-staging-alerts-cron-secret
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v21.0
META_WA_TEMPLATE_NAME=property_alert_v1

N8N_SCRAPER_WEBHOOK_URL=
N8N_WEBHOOK_SHARED_SECRET=

FEATURE_INSFORGE_AUTH=true
FEATURE_INSFORGE_PROPERTIES=true
FEATURE_INSFORGE_SCRAPER=true
FEATURE_INSFORGE_MARKETING=true
FEATURE_INSFORGE_MANAGER=true
FEATURE_ADMIN_IMPERSONATION=true
FEATURE_SKIP_EMAIL_VERIFICATION=true
FEATURE_COMPARE=true
FEATURE_FAVORITES_SYNC=true
FEATURE_SAVED_SEARCH=true
FEATURE_WHATSAPP_ALERTS=true
FEATURE_ZONE_INSIGHTS=true
FEATURE_THEME_LAB_EDITORIAL=true
FEATURE_GEOCATASTRO_LOOKUP=true
FEATURE_LEGAL_COMMISSION_GUIDE=true
FEATURE_AGENCY_VALUE_SCORE=true
